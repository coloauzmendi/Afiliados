---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getSubcategoriasConDesde } from '../lib/db';
import { formatPrecio, nombreCorto } from '../lib/productos';

const subcategorias = await getSubcategoriasConDesde();
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} wide>
	<section class="intro">
		<p class="eyebrow">ofertas revisadas a mano, no scrapeadas</p>
		<h1>Elegí una categoría</h1>
	</section>

	<section class="carrusel-wrap">
		{
			subcategorias.length === 0 ? (
				<p class="vacio">Todavía no hay categorías publicadas.</p>
			) : (
				<>
					<button class="flecha izq" type="button" aria-label="Anterior" data-dir="-1">
						‹
					</button>
					<div class="carrusel" id="carrusel">
						{subcategorias.map((sub) => (
							<a class="tarjeta" href={`/${sub.sector}/${sub.slug}`}>
								<div class="tarjeta-img">
									{sub.imagenPortada ? (
										<img src={sub.imagenPortada} alt={nombreCorto(sub.slug)} loading="lazy" />
									) : (
										<span class="sin-imagen">Próximamente</span>
									)}
								</div>
								<div class="tarjeta-info">
									<h2>{nombreCorto(sub.slug)}</h2>
									{sub.desde !== null && (
										<span class="tarjeta-precio">desde {formatPrecio(sub.desde)}</span>
									)}
									<span class="tarjeta-cta">Ver todas las ofertas →</span>
								</div>
							</a>
						))}
					</div>
					<button class="flecha der" type="button" aria-label="Siguiente" data-dir="1">
						›
					</button>
				</>
			)
		}
	</section>

	<p class="mas-info"><a href="/sobre">¿Por qué confiar en esto?</a></p>
</BaseLayout>

<style>
	.intro {
		padding: 2.5em 0 1.5em;
	}
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.75em;
		font-weight: 700;
		color: var(--accent);
		margin: 0 0 0.5em;
	}
	.intro h1 {
		font-size: 2em;
		margin: 0;
	}

	.carrusel-wrap {
		position: relative;
		padding-bottom: 2.5em;
	}
	.carrusel {
		display: flex;
		gap: 1.4em;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		-webkit-overflow-scrolling: touch;
		padding: 0.3em 0.3em 1em;
		scrollbar-width: thin;
	}
	.tarjeta {
		flex: 0 0 auto;
		width: 300px;
		scroll-snap-align: start;
		display: flex;
		flex-direction: column;
		border: 1px solid rgb(var(--gray-light));
		border-top: 3px solid var(--yellow);
		border-radius: 10px;
		background: #fff;
		text-decoration: none;
		color: inherit;
		overflow: hidden;
	}
	.tarjeta:hover {
		border-color: var(--accent);
		border-top-color: var(--yellow);
	}
	.tarjeta-img {
		height: 260px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #fff;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.tarjeta-img img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		padding: 1.2em;
		border-radius: 0;
	}
	.sin-imagen {
		font-size: 0.8em;
		color: rgb(var(--gray));
	}
	.tarjeta-info {
		padding: 1.2em;
		display: flex;
		flex-direction: column;
		gap: 0.3em;
	}
	.tarjeta-info h2 {
		font-size: 1.15em;
		margin: 0;
	}
	.tarjeta-precio {
		font-size: 0.85em;
		font-weight: 700;
		color: rgb(var(--black));
	}
	.tarjeta-cta {
		font-size: 0.85em;
		color: var(--accent);
		font-weight: 600;
		margin-top: 0.4em;
	}

	.flecha {
		position: absolute;
		top: 110px;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		border: 1px solid rgb(var(--gray-light));
		background: #fff;
		font-size: 1.4em;
		line-height: 1;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: var(--box-shadow);
	}
	.flecha:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.flecha.izq {
		left: -20px;
	}
	.flecha.der {
		right: -20px;
	}
	.vacio {
		color: rgb(var(--gray));
	}

	.mas-info {
		padding-bottom: 3em;
	}
	.mas-info a {
		color: rgb(var(--gray));
		font-size: 0.9em;
	}
	.mas-info a:hover {
		color: var(--accent);
	}

	@media (max-width: 720px) {
		.flecha {
			display: none;
		}
		.tarjeta {
			width: 78vw;
		}
	}
</style>

<script>
	const carrusel = document.getElementById('carrusel');
	document.querySelectorAll<HTMLButtonElement>('.flecha').forEach((boton) => {
		boton.addEventListener('click', () => {
			const dir = Number(boton.dataset.dir);
			carrusel?.scrollBy({ left: dir * 320, behavior: 'smooth' });
		});
	});
</script>
