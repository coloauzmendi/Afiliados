---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getSubcategoriasConDesde, getTodosLosProductos } from '../lib/db';
import { formatFecha, formatPrecio, nombreCorto, sectorLabel, SECTOR_LABELS } from '../lib/productos';

const [subcategorias, productos] = await Promise.all([getSubcategoriasConDesde(), getTodosLosProductos()]);

const totalCategorias = Object.keys(SECTOR_LABELS).length;
const plataformas = [...new Set(productos.map((p) => p.plataforma))].sort();
const ultimaRevision =
	subcategorias.length > 0
		? formatFecha(subcategorias.reduce((max, s) => (s.fecha > max ? s.fecha : max), subcategorias[0].fecha))
		: null;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} wide>
	<section class="hero">
		<div class="hero-grid">
			<div class="hero-copy">
				<p class="kicker">Catálogo revisado a mano, no scrapeado</p>
				<h1 class="headline">Productos digitales que <em>valen</em> lo que cuestan.</h1>
				<p class="hero-sub">{SITE_DESCRIPTION}</p>
				<a href="#catalogo" class="hero-cta">Ver el catálogo</a>
				<span class="scroll-hint" aria-hidden="true">↓</span>
			</div>
			<div class="filecard">
				<div class="filecard-tape"></div>
				<div class="ledger">
					<div class="ledger-row"><span class="label">Categorías</span><span class="val count-up" data-count={totalCategorias}>0</span></div>
					<div class="ledger-row"><span class="label">Productos revisados</span><span class="val brass count-up" data-count={productos.length}>0</span></div>
					{
						plataformas.length > 0 && (
							<div class="ledger-row">
								<span class="label">Plataformas</span>
								<span class="val">{plataformas.join(', ')}</span>
							</div>
						)
					}
					{
						ultimaRevision && (
							<div class="ledger-row">
								<span class="label">Última revisión</span>
								<span class="val">{ultimaRevision}</span>
							</div>
						)
					}
				</div>
			</div>
		</div>
	</section>

	<section class="block" id="catalogo">
		<div class="block-head reveal">
			<div>
				<p class="eyebrow">Explorá por categoría</p>
				<h2 class="block-title">Los estantes del catálogo</h2>
			</div>
			<p class="block-note">Cada categoría tiene su propio criterio de selección — deslizá para verlas.</p>
		</div>

		{
			subcategorias.length === 0 ? (
				<p class="vacio">Todavía no hay categorías publicadas.</p>
			) : (
				<>
					<div class="carrusel-viewport reveal" style="transition-delay: 0.12s">
						<button class="flecha izq" type="button" aria-label="Anterior" data-dir="-1">
							‹
						</button>
						<div class="carrusel" id="carrusel">
							{subcategorias.map((sub) => (
								<a class="card" href={`/${sub.sector}/${sub.slug}`} style={`--tint: var(--${sub.sector})`}>
									<div class="card-cover">
										<p class="spine">{sectorLabel(sub.sector)}</p>
									</div>
									<div class="card-body">
										<h3 class="card-title">{nombreCorto(sub.slug)}</h3>
										<p class="card-sample">{sub.resumen}</p>
										<div class="card-foot">
											<span class="card-price">
												{sub.desde !== null ? `Desde ${formatPrecio(sub.desde.valor, sub.desde.moneda)}` : 'Ver productos'}
											</span>
											<span class="card-go">Ver más →</span>
										</div>
									</div>
								</a>
							))}
						</div>
						<button class="flecha der" type="button" aria-label="Siguiente" data-dir="1">
							›
						</button>
					</div>

					{subcategorias.length > 1 && (
						<div class="puntos" id="puntos">
							{subcategorias.map((_, i) => (
								<button class="punto" type="button" data-index={i} aria-label={`Ir a la categoría ${i + 1}`} />
							))}
						</div>
					)}
				</>
			)
		}
	</section>

	<p class="mas-info"><a href="/sobre">Sobre {SITE_TITLE} — ¿por qué confiar en esto?</a></p>
</BaseLayout>

<style>
	.hero {
		padding: 3.2em 0 2.5em;
		border-bottom: 1px solid var(--sky-line);
	}
	.hero-grid {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: 3em;
		align-items: end;
	}
	.hero-copy {
		position: relative;
	}
	@keyframes entrada {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	.kicker,
	.headline,
	.hero-sub,
	.hero-cta {
		animation: entrada 0.6s ease both;
	}
	.headline {
		animation-delay: 0.08s;
	}
	.hero-sub {
		animation-delay: 0.16s;
	}
	.hero-cta {
		animation-delay: 0.24s;
	}

	.kicker {
		display: flex;
		align-items: center;
		font-size: 0.85em;
		color: var(--slate);
		border-left: 2px solid var(--brass);
		padding-left: 0.75em;
		margin: 0 0 1.4em;
	}
	.headline {
		font-size: clamp(2em, 4.2vw, 3.1em);
		line-height: 1.08;
		margin: 0 0 0.5em;
		text-wrap: balance;
	}
	.headline em {
		font-style: italic;
		color: var(--software);
		font-weight: 500;
	}
	.hero-sub {
		font-size: 1.05em;
		line-height: 1.6;
		color: var(--slate);
		max-width: 46ch;
		margin: 0 0 1.4em;
	}
	.hero-cta {
		display: inline-flex;
		align-items: center;
		background: var(--brass);
		color: var(--sky);
		font-weight: 600;
		font-size: 0.95em;
		padding: 0.8em 1.4em;
		text-decoration: none;
		border-radius: var(--radius-md);
		transition:
			background 0.15s ease,
			transform 0.1s ease;
	}
	.hero-cta:hover {
		background: var(--navy-900);
		color: var(--sky);
	}
	.hero-cta:active {
		transform: scale(0.95);
	}

	.scroll-hint {
		display: block;
		position: absolute;
		left: 0;
		top: 100%;
		margin-top: 0.7em;
		color: var(--slate);
		font-size: 1.15em;
		opacity: 0;
		animation:
			entrada 0.6s ease 0.3s both,
			rebote 1.8s ease-in-out 0.9s infinite;
	}
	@keyframes rebote {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(6px);
		}
	}

	@keyframes clava {
		from {
			opacity: 0;
			transform: rotate(-6deg) scale(0.92) translateY(10px);
		}
		to {
			opacity: 1;
			transform: rotate(0.5deg) scale(1) translateY(0);
		}
	}
	/* Simula que la cinta viene "de frente" (grande, cerca de cámara,
	   como si te la tiraran encima) y se aplasta contra la ficha al
	   asentarse, en vez de caer desde atrás. */
	@keyframes pega-cinta {
		0% {
			opacity: 0;
			transform: translateX(-50%) rotate(-3deg) scale(2.6);
			filter: blur(2px);
		}
		45% {
			opacity: 1;
			filter: blur(0);
		}
		58% {
			transform: translateX(-50%) rotate(-3deg) scale(0.85);
		}
		76% {
			transform: translateX(-50%) rotate(-3deg) scale(1.1);
		}
		100% {
			opacity: 1;
			transform: translateX(-50%) rotate(-3deg) scale(1);
			filter: blur(0);
		}
	}
	.filecard {
		position: relative;
	}
	.filecard-tape {
		position: absolute;
		top: -10px;
		left: 50%;
		width: 64px;
		height: 20px;
		background: rgba(230, 195, 74, 0.28);
		border: 1px solid rgba(230, 195, 74, 0.4);
		transform: translateX(-50%) rotate(-3deg);
		z-index: 2;
		animation: pega-cinta 0.6s ease-out 1.05s both;
	}
	.ledger {
		font-family: var(--font-mono, monospace);
		border: 1px solid var(--navy-700);
		background: var(--navy-900);
		border-radius: var(--radius-md);
		transform: rotate(0.5deg);
		box-shadow: 0 14px 32px -18px rgba(16, 26, 44, 0.5);
		animation: clava 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
	}
	.ledger-row {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		padding: 0.8em 1.1em;
		font-size: 0.8em;
		border-bottom: 1px solid var(--navy-700);
	}
	.ledger-row:last-child {
		border-bottom: none;
	}
	.ledger-row .label {
		color: var(--mist-dim);
		white-space: nowrap;
	}
	.ledger-row .val {
		color: var(--sky);
		text-align: right;
	}
	.ledger-row .val.brass {
		color: var(--brass-bright);
	}

	.block {
		padding: 1.6em 0 2em;
		scroll-margin-top: 72px;
	}
	.reveal {
		opacity: 0;
		transform: translateY(16px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}
	.reveal.in-view {
		opacity: 1;
		transform: none;
	}
	.block-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1.5em;
		flex-wrap: wrap;
		margin-bottom: 1em;
	}
	.eyebrow {
		display: flex;
		align-items: center;
		gap: 0.5em;
		font-size: 0.85em;
		color: var(--slate);
		margin: 0 0 0.5em;
	}
	.eyebrow::before {
		content: '';
		width: 16px;
		height: 1px;
		background: var(--brass);
	}
	.block-title {
		margin: 0;
	}
	.block-note {
		font-size: 0.9em;
		color: var(--slate);
		max-width: 32ch;
		margin: 0;
	}

	.carrusel-viewport {
		position: relative;
	}
	.carrusel {
		display: flex;
		gap: 1.4em;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		-webkit-overflow-scrolling: touch;
		padding: 0.3em 0.2em 0.7em;
		scrollbar-width: none;
	}
	.carrusel::-webkit-scrollbar {
		display: none;
	}

	/* Cards bien horizontales: la portada es una franja angosta a la
	   izquierda (como el lomo de un libro), el cuerpo ocupa el resto —
	   así la card entera (título a precio) entra en la pantalla sin
	   scroll vertical extra. */
	.card {
		scroll-snap-align: center;
		flex: 0 0 auto;
		display: grid;
		grid-template-columns: 118px 1fr;
		width: min(860px, 86vw);
		height: min(300px, 42vh);
		min-height: 200px;
		background: var(--paper);
		color: var(--navy-900);
		overflow: hidden;
		text-decoration: none;
		border: 1px solid var(--paper-dim);
		border-radius: var(--radius-lg);
		box-shadow: var(--box-shadow);
		opacity: 0.4;
		filter: brightness(0.8) saturate(0.9);
		transform: scale(0.92);
		transition:
			opacity 0.35s ease,
			filter 0.35s ease,
			transform 0.35s ease,
			border-color 0.2s ease,
			box-shadow 0.25s ease;
	}
	.card.activa {
		opacity: 1;
		filter: none;
		transform: scale(1);
	}
	.card:hover {
		border-color: var(--brass);
	}
	.card.activa:hover {
		box-shadow: 0 20px 40px -18px rgba(16, 26, 44, 0.45);
	}
	.card-cover {
		position: relative;
		height: 100%;
		overflow: hidden;
		background: var(--tint);
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.25s ease;
	}
	.card:hover .card-cover {
		transform: scale(1.05);
	}
	.card-cover::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image: repeating-linear-gradient(45deg, rgba(16, 26, 44, 0.09) 0 1px, transparent 1px 9px);
	}
	.card-cover .spine {
		position: relative;
		margin: 0;
		white-space: nowrap;
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		font-family: var(--font-display, Georgia, serif);
		font-style: italic;
		font-weight: 600;
		font-size: 1.2rem;
		letter-spacing: 0.01em;
		color: rgba(242, 236, 221, 0.92);
	}
	.card-cover::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		right: -6px;
		width: 12px;
		background-image: radial-gradient(circle at 6px 8px, var(--paper) 6px, transparent 6.5px);
		background-size: 100% 22px;
		background-position: 0 -11px;
	}
	.card-body {
		padding: 1.2em 1.6em;
		display: flex;
		flex-direction: column;
		gap: 0.5em;
		min-width: 0;
	}
	.card-title {
		font-size: 1.3em;
		margin: 0;
		line-height: 1.25;
	}
	.card-sample {
		font-size: 0.88em;
		color: #746c58;
		line-height: 1.45;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.card-foot {
		margin-top: auto;
		padding-top: 0.7em;
		border-top: 1px dashed #cfc7ac;
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.95em;
	}
	.card-price {
		font-family: var(--font-mono, monospace);
		font-weight: 500;
	}
	.card-go {
		color: color-mix(in srgb, var(--tint) 60%, #101a2c);
		font-weight: 500;
	}

	.flecha {
		position: absolute;
		top: 45%;
		transform: translateY(-50%);
		width: 46px;
		height: 46px;
		border-radius: 50%;
		border: 1px solid var(--sky-line);
		background: #fff;
		font-size: 1.5em;
		line-height: 1;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: var(--box-shadow);
		z-index: 2;
		color: var(--navy-900);
		transition:
			border-color 0.2s ease,
			transform 0.2s ease;
	}
	.flecha:hover {
		border-color: var(--brass);
		transform: translateY(-50%) scale(1.06);
	}
	.flecha.izq {
		left: 4px;
	}
	.flecha.der {
		right: 4px;
	}
	.vacio {
		color: var(--slate);
	}

	.puntos {
		display: flex;
		justify-content: center;
		gap: 0.5em;
		margin-top: 0.4em;
	}
	.punto {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		border: none;
		padding: 0;
		background: var(--sky-line);
		cursor: pointer;
		transition:
			background 0.2s ease,
			transform 0.2s ease;
	}
	.punto.activo {
		background: var(--brass);
		transform: scale(1.3);
	}

	.mas-info {
		padding: 0 0 3em;
	}
	.mas-info a {
		color: var(--slate);
		font-size: 0.9em;
	}
	.mas-info a:hover {
		color: var(--software);
	}

	@media (max-width: 800px) {
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 2em;
		}
		.flecha {
			display: none;
		}
		.card {
			grid-template-columns: 84px 1fr;
			width: 92vw;
			height: min(260px, 50vh);
		}
		.card-cover .spine {
			font-size: 0.95rem;
		}
	}
</style>

<script>
	const carrusel = document.getElementById('carrusel');
	const tarjetas = Array.from(document.querySelectorAll<HTMLAnchorElement>('.card'));
	const puntos = Array.from(document.querySelectorAll<HTMLButtonElement>('.punto'));

	let indiceActivo = 0;

	function marcarActiva(index: number) {
		indiceActivo = index;
		tarjetas.forEach((t, i) => t.classList.toggle('activa', i === index));
		puntos.forEach((p, i) => p.classList.toggle('activo', i === index));
	}

	if (carrusel && tarjetas.length) {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting && entry.intersectionRatio > 0.6) {
						marcarActiva(tarjetas.indexOf(entry.target as HTMLAnchorElement));
					}
				});
			},
			{ root: carrusel, threshold: [0.6] },
		);
		tarjetas.forEach((t) => observer.observe(t));
		marcarActiva(0);

		document.querySelectorAll<HTMLButtonElement>('.flecha').forEach((boton) => {
			boton.addEventListener('click', () => {
				const dir = Number(boton.dataset.dir);
				const siguiente = (indiceActivo + dir + tarjetas.length) % tarjetas.length;
				tarjetas[siguiente].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
			});
		});

		puntos.forEach((p, i) => {
			p.addEventListener('click', () => {
				tarjetas[i].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
			});
		});
	}

	// Los números de la ficha del hero cuentan desde 0 hasta el valor real.
	const prefiereMenosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	document.querySelectorAll<HTMLElement>('.count-up').forEach((el) => {
		const meta = Number(el.dataset.count);
		if (!meta) return;
		if (prefiereMenosMovimiento) {
			el.textContent = meta.toLocaleString('es-AR');
			return;
		}
		const duracion = 900;
		const inicio = performance.now() + 400; // sincronizado con la animación de "pinchado" de la ficha
		function paso(ahora: number) {
			const progreso = Math.min(Math.max((ahora - inicio) / duracion, 0), 1);
			const suavizado = 1 - Math.pow(1 - progreso, 3);
			el.textContent = Math.round(meta * suavizado).toLocaleString('es-AR');
			if (progreso < 1) requestAnimationFrame(paso);
		}
		requestAnimationFrame(paso);
	});

	// Título del bloque y carrusel aparecen con un fade+slide al entrar en pantalla.
	const elementosReveal = document.querySelectorAll<HTMLElement>('.reveal');
	if (elementosReveal.length) {
		const revealObserver = new IntersectionObserver(
			(entries, obs) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('in-view');
						obs.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 },
		);
		elementosReveal.forEach((el) => revealObserver.observe(el));
	}
</script>
