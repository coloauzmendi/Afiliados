---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { SITE_TITLE } from '../../consts';
import { getSubcategoriasConDesde } from '../../lib/catalogo';
import { sectorLabel } from '../../lib/productos';

export async function getStaticPaths() {
	const todas = await getSubcategoriasConDesde();
	const sectores = [...new Set(todas.map((s) => s.sector))];

	return sectores.map((sector) => ({
		params: { sector },
		props: {
			subcategorias: todas.filter((s) => s.sector === sector),
		},
	}));
}

const { sector } = Astro.params;
const { subcategorias } = Astro.props;
const label = sectorLabel(sector as string);
const ordenadas = [...subcategorias].sort((a, b) => b.fecha.valueOf() - a.fecha.valueOf());
---

<BaseLayout
	title={`${label} — ${SITE_TITLE}`}
	description={`Comparativas de ${label.toLowerCase()} elegidas y revisadas a mano.`}
	wide
>
	<nav class="breadcrumb"><a href="/">Inicio</a> / {label}</nav>

	<header class="cabecera">
		<p class="eyebrow">Categoría</p>
		<h1>{label}</h1>
		<p class="intro">
			{ordenadas.length} {ordenadas.length === 1 ? 'nota publicada' : 'notas publicadas'} en esta
			categoría.
		</p>
	</header>

	<div class="grid">
		{ordenadas.map((sub) => <ReviewCard subcategoria={sub} />)}
	</div>
</BaseLayout>

<style>
	.breadcrumb {
		font-size: 0.85em;
		color: var(--slate);
		margin: 2em 0 1em;
	}
	.breadcrumb a {
		color: var(--slate);
	}
	.breadcrumb a:hover {
		color: var(--software);
	}
	.cabecera {
		border-bottom: 1px solid var(--sky-line);
		padding-bottom: 1.6em;
		margin-bottom: 2em;
	}
	.eyebrow {
		display: flex;
		align-items: center;
		gap: 0.5em;
		font-size: 0.85em;
		color: var(--slate);
		margin: 0 0 0.5em;
	}
	.eyebrow::before {
		content: '';
		width: 16px;
		height: 1px;
		background: var(--brass);
	}
	.cabecera h1 {
		margin-bottom: 0.3em;
	}
	.intro {
		color: var(--slate);
		margin: 0;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.2em;
		padding-bottom: 3em;
	}
</style>
