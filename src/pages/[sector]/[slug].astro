---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allReviews = await getCollection('reviews');
  return allReviews.map((review) => ({
    params: { sector: review.data.sector, slug: review.id },
    props: { review },
  }));
}

const { review } = Astro.props;
const { Content } = await render(review);
---
<html>
  <head>
    <meta charset="UTF-8" />
    <title>{review.data.title}</title>
  </head>
  <body>
    <article>
      <h1>{review.data.title}</h1>
      <p><strong>Comisión:</strong> {review.data.comision}</p>
      <Content />
      <a href={review.data.linkAfiliado} target="_blank" rel="nofollow sponsored">
        Ir a la oferta
      </a>
    </article>
  </body>
</html>