---
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FiltroProductos from '../../components/FiltroProductos.jsx';
import { getSubcategorias, getTodosLosProductos } from '../../lib/db';
import { formatFecha, sectorLabel } from '../../lib/productos';

export async function getStaticPaths() {
	const [subcategorias, todosProductos] = await Promise.all([
		getSubcategorias(),
		getTodosLosProductos(),
	]);

	return subcategorias.map((subcategoria) => ({
		params: { sector: subcategoria.sector, slug: subcategoria.slug },
		props: {
			subcategoria,
			productos: todosProductos.filter((p) => p.subcategoriaSlug === subcategoria.slug),
		},
	}));
}

const { subcategoria, productos } = Astro.props;
const label = sectorLabel(subcategoria.sector);
const contenidoHtml = subcategoria.contenido ? await marked.parse(subcategoria.contenido) : '';

const productosParaFiltro = productos.map((p) => ({
	id: p.id,
	nombre: p.nombre,
	precio: p.precio,
	badge: p.destacado,
	link: p.link,
	imagen: p.imagen,
}));

// Para la vista previa al compartir el link (Open Graph / Twitter Card).
const imagenPortada = productos.find((p) => p.imagen)?.imagen ?? undefined;
---

<BaseLayout
	title={`${subcategoria.title} — Ahorrando`}
	description={subcategoria.resumen}
	image={imagenPortada}
	wide
>
	<nav class="breadcrumb">
		<a href="/">Inicio</a> / <a href={`/${subcategoria.sector}`}>{label}</a> / {subcategoria.title}
	</nav>

	<header class="review-head">
		<span class="sector-pill">{label}</span>
		<h1>{subcategoria.title}</h1>
		<p class="resumen">{subcategoria.resumen}</p>
		<p class="fecha">Actualizado el {formatFecha(subcategoria.fecha)}</p>
	</header>

	<div
		id="compartir-articulo"
		class="compartir-articulo"
		data-titulo={subcategoria.title}
		data-resumen={subcategoria.resumen}
		hidden
	>
		<span class="compartir-label">Compartir esta nota:</span>
		<a id="compartir-x" class="compartir-btn btn-x" target="_blank" rel="noopener noreferrer">X</a>
		<a
			id="compartir-whatsapp"
			class="compartir-btn btn-whatsapp"
			target="_blank"
			rel="noopener noreferrer"
		>
			WhatsApp
		</a>
		<a
			id="compartir-telegram"
			class="compartir-btn btn-telegram"
			target="_blank"
			rel="noopener noreferrer"
		>
			Telegram
		</a>
	</div>

	{
		productosParaFiltro.length > 0 && (
			<section class="comparativa">
				<FiltroProductos productos={productosParaFiltro} client:load />
			</section>
		)
	}

	<div class="review-body">
		{contenidoHtml && <div class="prose" set:html={contenidoHtml} />}

		<p class="disclaimer">
			Este artículo puede contener links de afiliado. Si comprás a través de ellos, nos llega una
			comisión chica que no te cuesta nada extra a vos.
		</p>
	</div>
</BaseLayout>

<script>
	// Botones de "compartir esta nota" — solo se muestran para el dueño del
	// sitio (panel activado con ?panel=... en BaseLayout), para postear en X
	// apenas se publica un artículo nuevo, sin pagar la API de X.
	function panelActivo() {
		try {
			return localStorage.getItem('panelActivo') === '1';
		} catch {
			return false;
		}
	}

	const contenedor = document.getElementById('compartir-articulo');
	if (contenedor && panelActivo()) {
		const titulo = contenedor.dataset.titulo ?? '';
		const resumen = contenedor.dataset.resumen ?? '';
		const texto = `🔥 ${titulo}: ${resumen} → mirá la comparativa completa en Ahorrando`;
		const url = window.location.href;

		const botonX = document.getElementById('compartir-x');
		const botonWhatsapp = document.getElementById('compartir-whatsapp');
		const botonTelegram = document.getElementById('compartir-telegram');

		if (botonX instanceof HTMLAnchorElement) {
			botonX.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(texto)}&url=${encodeURIComponent(url)}`;
		}
		if (botonWhatsapp instanceof HTMLAnchorElement) {
			botonWhatsapp.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(`${texto} ${url}`)}`;
		}
		if (botonTelegram instanceof HTMLAnchorElement) {
			botonTelegram.href = `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(texto)}`;
		}

		contenedor.hidden = false;
	}
</script>

<style>
	.breadcrumb {
		font-size: 0.85em;
		color: rgb(var(--gray));
		margin: 2em 0 1.5em;
	}
	.breadcrumb a {
		color: rgb(var(--gray));
	}
	.breadcrumb a:hover {
		color: var(--accent);
	}
	.review-head {
		max-width: 100%;
		background: var(--yellow-soft);
		border: 1px solid var(--yellow);
		border-radius: 10px;
		padding: 1.6em 1.8em;
	}
	.sector-pill {
		display: inline-block;
		font-size: 0.75em;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--accent);
		font-weight: 700;
		margin-bottom: 0.6em;
	}
	.review-head h1 {
		margin: 0 0 0.4em;
		line-height: 1.15;
		max-width: 30ch;
	}
	.resumen {
		font-size: 1.1em;
		color: rgb(var(--gray-dark));
		margin: 0 0 0.4em;
		max-width: 60ch;
	}
	.fecha {
		font-size: 0.85em;
		color: rgb(var(--gray));
		margin: 0 0 1.5em;
	}
	.compartir-articulo {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5em;
		margin: 1em 0 0;
	}
	.compartir-label {
		font-size: 0.8em;
		color: rgb(var(--gray));
		margin-right: 0.2em;
	}
	.compartir-btn {
		font-size: 0.78em;
		font-weight: 700;
		color: #fff;
		text-decoration: none;
		padding: 0.35em 0.7em;
		border-radius: 4px;
	}
	.btn-x {
		background: #000;
	}
	.btn-whatsapp {
		background: #25d366;
	}
	.btn-telegram {
		background: #26a5e4;
	}
	.comparativa {
		margin: 1.5em 0 3em;
		background: var(--yellow-soft);
		border: 1px solid var(--yellow);
		border-radius: 10px;
		padding: 1.6em;
	}
	.review-body {
		max-width: 760px;
		padding-bottom: 4em;
	}
	.prose {
		color: rgb(var(--gray-dark));
	}
	.prose :global(h2) {
		font-size: 1.3em;
		margin-top: 1.5em;
	}
	.disclaimer {
		font-size: 0.8em;
		color: rgb(var(--gray));
		font-style: italic;
		border-top: 1px solid rgb(var(--gray-light));
		padding-top: 1.2em;
		margin-top: 2em;
	}
</style>
