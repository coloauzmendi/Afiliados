---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FiltroProductos from '../../components/FiltroProductos.jsx';
import { formatFecha, parsePrecio, sectorLabel } from '../../lib/productos';

export async function getStaticPaths() {
	const allReviews = await getCollection('reviews');
	return allReviews.map((review) => ({
		params: { sector: review.data.sector, slug: review.id },
		props: { review },
	}));
}

const { review } = Astro.props;
const { Content } = await render(review);
const label = sectorLabel(review.data.sector);

const productos = review.data.productos?.map((p) => ({
	id: p.nombre,
	nombre: p.nombre,
	precio: parsePrecio(p.precioAprox),
	badge: p.destacado,
	link: p.link,
	imagen: p.imagen,
}));
---

<BaseLayout title={`${review.data.title} — Ahorrando`} description={review.data.resumen} wide>
	<nav class="breadcrumb">
		<a href="/">Inicio</a> / <a href={`/${review.data.sector}`}>{label}</a> / {review.data.title}
	</nav>

	<header class="review-head">
		<span class="sector-pill">{label}</span>
		<h1>{review.data.title}</h1>
		<p class="resumen">{review.data.resumen}</p>
		<p class="fecha">Actualizado el {formatFecha(review.data.fecha)}</p>
	</header>

	{
		productos && productos.length > 0 && (
			<section class="comparativa">
				<FiltroProductos productos={productos} client:load />
			</section>
		)
	}

	{
		!productos && review.data.linkAfiliado && (
			<a
				class="cta"
				href={review.data.linkAfiliado}
				target="_blank"
				rel="nofollow sponsored noopener"
			>
				Ver oferta
			</a>
		)
	}

	<div class="review-body">
		<div class="prose">
			<Content />
		</div>

		<p class="disclaimer">
			Este artículo puede contener links de afiliado. Si comprás a través de ellos, nos llega una
			comisión chica que no te cuesta nada extra a vos.
		</p>
	</div>
</BaseLayout>

<style>
	.breadcrumb {
		font-size: 0.85em;
		color: rgb(var(--gray));
		margin: 2em 0 1.5em;
	}
	.breadcrumb a {
		color: rgb(var(--gray));
	}
	.breadcrumb a:hover {
		color: var(--accent);
	}
	.review-head {
		max-width: 760px;
	}
	.sector-pill {
		display: inline-block;
		font-size: 0.75em;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--accent);
		font-weight: 700;
		margin-bottom: 0.6em;
	}
	.review-head h1 {
		margin: 0 0 0.4em;
		line-height: 1.15;
	}
	.resumen {
		font-size: 1.1em;
		color: rgb(var(--gray-dark));
		margin: 0 0 0.4em;
	}
	.fecha {
		font-size: 0.85em;
		color: rgb(var(--gray));
		margin: 0 0 1.5em;
	}
	.comparativa {
		margin: 1.5em 0 3em;
	}
	.cta {
		display: inline-block;
		margin: 0.5em 0 3em;
		background: var(--yellow);
		color: rgb(var(--black));
		padding: 0.9em 1.8em;
		border-radius: 6px;
		text-decoration: none;
		font-weight: 700;
		font-size: 1.05em;
	}
	.cta:hover {
		background: var(--yellow-dark);
	}
	.review-body {
		max-width: 760px;
		padding-bottom: 4em;
	}
	.prose {
		color: rgb(var(--gray-dark));
	}
	.prose :global(h2) {
		font-size: 1.3em;
		margin-top: 1.5em;
	}
	.disclaimer {
		font-size: 0.8em;
		color: rgb(var(--gray));
		font-style: italic;
		border-top: 1px solid rgb(var(--gray-light));
		padding-top: 1.2em;
		margin-top: 2em;
	}
</style>
