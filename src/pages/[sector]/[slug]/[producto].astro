---
import { marked } from 'marked';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Comentarios from '../../../components/Comentarios.jsx';
import { SITE_TITLE } from '../../../consts';
import { getSubcategorias, getTodosLosProductos } from '../../../lib/catalogo';
import { formatPrecio, sectorLabel } from '../../../lib/productos';

// Página estática (se genera en el build). La sección de comentarios (más
// abajo, componente React) guarda/lee en localStorage — sin fetch a ningún
// endpoint, ver src/components/Comentarios.jsx.
export async function getStaticPaths() {
	const [subcategorias, todosProductos] = await Promise.all([
		getSubcategorias(),
		getTodosLosProductos(),
	]);
	const porSlug = new Map(subcategorias.map((s) => [s.slug, s]));

	return todosProductos
		.map((producto) => {
			const subcategoria = porSlug.get(producto.subcategoriaSlug);
			if (!subcategoria) return null;
			return {
				params: { sector: subcategoria.sector, slug: subcategoria.slug, producto: producto.slug },
				props: { producto, subcategoria },
			};
		})
		.filter((p) => p !== null);
}

const { producto, subcategoria } = Astro.props;
const label = sectorLabel(subcategoria.sector);
const resenaHtml = producto.resena ? await marked.parse(producto.resena) : '';
---

<BaseLayout
	title={`${producto.nombre} — ${SITE_TITLE}`}
	description={producto.resena ? producto.resena.slice(0, 160) : subcategoria.resumen}
	image={producto.imagen ?? undefined}
>
	<nav class="breadcrumb">
		<a href="/">Inicio</a> / <a href={`/${subcategoria.sector}`}>{label}</a> / <a
			href={`/${subcategoria.sector}/${subcategoria.slug}`}>{subcategoria.title}</a
		> / {producto.nombre}
	</nav>

	<div class="producto-head" style={`--tint: var(--${subcategoria.sector})`}>
		<div class="producto-imagen">
			{
				producto.imagen ? (
					<img src={producto.imagen} alt={producto.nombre} />
				) : (
					<span class="producto-imagen-vacia">Sin imagen todavía</span>
				)
			}
		</div>

		<div class="producto-buybox">
			<div class="producto-top">
				<span class="producto-plataforma">{producto.plataforma}</span>
				{producto.destacado && <span class="producto-badge">{producto.destacado}</span>}
			</div>
			<h1>{producto.nombre}</h1>
			<div class="producto-precio-fila">
				<span class="producto-precio">{formatPrecio(producto.precio, producto.moneda)}</span>
				<a
					class="producto-cta"
					href={producto.link}
					target="_blank"
					rel="nofollow sponsored noopener"
				>
					Acceder →
				</a>
			</div>
			<p class="producto-nota">Te lleva a la página oficial de {producto.plataforma} para comprar.</p>
		</div>
	</div>

	<div class="producto-body">
		{
			resenaHtml ? (
				<div class="prose" set:html={resenaHtml} />
			) : (
				<p class="resena-pendiente">Todavía no cargamos la reseña completa de este producto — volvé pronto.</p>
			)
		}

		<p class="disclaimer">
			Este artículo puede contener links de afiliado. Si comprás a través de ellos, nos llega una
			comisión chica que no te cuesta nada extra a vos.
		</p>

		<Comentarios productoId={producto.id} client:load />
	</div>
</BaseLayout>

<style>
	.breadcrumb {
		font-size: 0.85em;
		color: var(--slate);
		margin: 2em 0 1.5em;
	}
	.breadcrumb a {
		color: var(--slate);
	}
	.breadcrumb a:hover {
		color: var(--software);
	}
	.producto-head {
		display: grid;
		grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
		gap: 1.8em;
		border-bottom: 3px solid var(--tint);
		padding-bottom: 1.8em;
	}
	.producto-imagen {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 1 / 1;
		background: #fff;
		border: 1px solid var(--paper-dim);
		border-radius: var(--radius-md);
		overflow: hidden;
	}
	.producto-imagen img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		padding: 1.2rem;
	}
	.producto-imagen-vacia {
		color: #cfc7ac;
		font-size: 0.85em;
	}
	.producto-buybox {
		display: flex;
		flex-direction: column;
	}
	.producto-top {
		display: flex;
		align-items: center;
		gap: 0.7em;
		margin-bottom: 0.6em;
	}
	.producto-plataforma {
		font-family: var(--font-mono, monospace);
		font-size: 0.72em;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: color-mix(in srgb, var(--tint) 65%, #101a2c);
		font-weight: 500;
	}
	.producto-badge {
		font-family: var(--font-mono, monospace);
		font-size: 0.75em;
		color: var(--brass);
	}
	.producto-buybox h1 {
		margin: 0 0 1em;
		line-height: 1.2;
		max-width: 26ch;
	}
	.producto-precio-fila {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		padding: 1em 1.1em;
		background: var(--sky);
		border: 1px solid var(--sky-line);
		border-radius: var(--radius-md);
	}
	.producto-precio {
		font-family: var(--font-mono, monospace);
		font-size: 1.6em;
		font-weight: 500;
		color: var(--navy-900);
	}
	.producto-cta {
		display: inline-block;
		background: var(--navy-900);
		color: var(--sky);
		padding: 0.7rem 1.3rem;
		border-radius: var(--radius-sm, 4px);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		white-space: nowrap;
		transition: background 0.15s ease, transform 0.1s ease;
	}
	.producto-cta:hover {
		background: var(--brass);
		color: var(--navy-900);
	}
	.producto-cta:active {
		transform: scale(0.96);
	}
	.producto-nota {
		font-size: 0.78em;
		color: #857c63;
		margin: 0.6em 0 0;
	}
	.producto-body {
		max-width: 760px;
		padding-bottom: 4em;
	}
	.prose {
		color: var(--slate);
		margin-top: 2em;
	}
	.prose :global(h2) {
		font-size: 1.3em;
		margin-top: 1.5em;
	}
	.resena-pendiente {
		color: var(--slate);
		font-style: italic;
		margin-top: 2em;
	}
	.disclaimer {
		font-size: 0.8em;
		color: var(--slate);
		font-style: italic;
		border-top: 1px solid var(--sky-line);
		padding-top: 1.2em;
		margin-top: 2em;
	}

	@media (max-width: 640px) {
		.producto-head {
			/* minmax(0, 1fr), no 1fr solo: sin el 0 el track no se achica más
			   allá del contenido (precio + botón "Acceder" sin wrap), y eso
			   empuja todo el layout más ancho que la pantalla. */
			grid-template-columns: minmax(0, 1fr);
		}
		.producto-precio-fila {
			flex-wrap: wrap;
			row-gap: 0.6em;
		}
	}
</style>
