---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`Página no encontrada — ${SITE_TITLE}`} description="Esta página no existe.">
	<div class="error">
		<p class="code">404</p>
		<h1>Che, esta página no existe</h1>
		<p>Puede que el link esté roto o que el producto ya no esté disponible. Volvé al inicio y seguí mirando.</p>
		<a class="btn" href="/">Ir al inicio</a>
	</div>
</BaseLayout>

<style>
	.error {
		text-align: center;
		padding: 5em 1em;
	}
	.code {
		font-family: var(--font-mono, monospace);
		font-size: 3.5em;
		font-weight: 500;
		color: var(--sky-line);
		margin: 0;
	}
	.error h1 {
		margin: 0.2em 0 0.5em;
	}
	.error p {
		color: var(--slate);
	}
	.btn {
		display: inline-block;
		margin-top: 1.5em;
		background: var(--brass);
		color: var(--sky);
		padding: 0.75em 1.4em;
		text-decoration: none;
		font-weight: 600;
	}
	.btn:hover {
		background: var(--navy-900);
		color: var(--sky);
	}
</style>
