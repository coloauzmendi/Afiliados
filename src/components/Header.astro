---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a href="/" class="brand">{SITE_TITLE}<span class="dot">.</span></a>
		<div class="internal-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/cursos">Cursos</HeaderLink>
			<HeaderLink href="/plantillas">Plantillas</HeaderLink>
			<HeaderLink href="/software">Software</HeaderLink>
			<HeaderLink href="/ebooks">Ebooks</HeaderLink>
			<HeaderLink href="/sobre">Sobre Digitalia</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		background: var(--navy-900);
		border-bottom: 1px solid var(--navy-700);
		position: sticky;
		top: 0;
		z-index: 20;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin: 0 auto;
		flex-wrap: wrap;
	}
	.brand {
		display: flex;
		align-items: baseline;
		text-decoration: none;
		padding: 0.7em 0;
		font-family: var(--font-display, Georgia, serif);
		font-style: italic;
		font-weight: 600;
		font-size: 1.3em;
		letter-spacing: -0.01em;
		color: var(--sky);
	}
	.dot {
		color: var(--brass-bright);
		font-style: normal;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.15em;
	}
	.internal-links :global(a) {
		padding: 0.75em 0.6em;
		color: var(--mist);
		text-decoration: none;
		font-size: 0.87em;
		position: relative;
	}
	.internal-links :global(a:hover) {
		color: var(--brass-bright);
	}
	.internal-links :global(a.active) {
		text-decoration: none;
		color: var(--sky);
	}
	.internal-links :global(a)::after {
		content: '';
		position: absolute;
		left: 0.6em;
		right: 0.6em;
		bottom: 0.6em;
		height: 1px;
		background: var(--brass-bright);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s ease;
	}
	.internal-links :global(a:hover)::after {
		transform: scaleX(1);
	}
	.internal-links :global(a.active)::after {
		background: var(--brass);
		transform: scaleX(1);
	}
</style>
