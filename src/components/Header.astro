---
import HeaderLink from './HeaderLink.astro';
import Logo from '../assets/logo-full.png';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a href="/" class="brand">
			<img src={Logo.src} alt={SITE_TITLE} class="logo" />
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/tecnologia">Tecnología</HeaderLink>
			<span class="soon">Finanzas <em>pronto</em></span>
			<span class="soon">SaaS &amp; IA <em>pronto</em></span>
			<span class="soon">Físicos <em>pronto</em></span>
			<HeaderLink href="/sobre">Sobre</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		background: #fff;
		border-bottom: 4px solid var(--yellow);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin: 0 auto;
		flex-wrap: wrap;
	}
	.brand {
		display: flex;
		align-items: center;
		text-decoration: none;
	}
	.logo {
		display: block;
		height: 76px;
		width: auto;
		object-fit: contain;
		border-radius: 0;
		padding: 0.5em 0;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	.internal-links :global(a) {
		padding: 1em 0.6em;
		color: rgb(var(--gray-dark));
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-size: 0.95em;
	}
	.internal-links :global(a.active) {
		text-decoration: none;
		border-bottom-color: var(--accent);
		color: rgb(var(--black));
	}
	.soon {
		padding: 1em 0.6em;
		font-size: 0.95em;
		color: rgb(var(--gray));
		cursor: default;
	}
	.soon em {
		font-style: normal;
		font-size: 0.7em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 1em;
		padding: 0.15em 0.5em;
		margin-left: 0.35em;
	}
	@media (max-width: 720px) {
		.soon {
			display: none;
		}
	}
</style>
