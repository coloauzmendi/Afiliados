---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a href="/" class="brand">
			{SITE_TITLE}
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/cursos">Cursos</HeaderLink>
			<HeaderLink href="/plantillas">Plantillas</HeaderLink>
			<HeaderLink href="/software">Software</HeaderLink>
			<HeaderLink href="/ebooks">Ebooks</HeaderLink>
			<HeaderLink href="/sobre">Sobre</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		background: #fff;
		border-bottom: 4px solid var(--yellow);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1100px;
		margin: 0 auto;
		flex-wrap: wrap;
	}
	.brand {
		display: flex;
		align-items: center;
		text-decoration: none;
		padding: 1em 0;
		font-size: 1.6em;
		font-weight: 700;
		color: rgb(var(--black));
		letter-spacing: -0.02em;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	.internal-links :global(a) {
		padding: 1em 0.6em;
		color: rgb(var(--gray-dark));
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-size: 0.95em;
	}
	.internal-links :global(a.active) {
		text-decoration: none;
		border-bottom-color: var(--accent);
		color: rgb(var(--black));
	}
</style>
