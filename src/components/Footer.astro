---
import { SITE_TITLE } from '../consts';
import { SECTOR_LABELS } from '../lib/productos';
const today = new Date();
const sectores = Object.entries(SECTOR_LABELS);
---

<footer>
	<div class="footer-inner">
		<div class="foot-top">
			<div class="foot-brand-col">
				<p class="foot-brand">{SITE_TITLE}<span class="dot">.</span></p>
				<p class="disclosure">
					Los links a productos son de afiliado, principalmente a plataformas como Hotmart, Envato,
					Udemy y Gumroad: si comprás desde acá, nos llega una comisión chica que no te cuesta nada
					extra.
				</p>
			</div>
			<div class="foot-nav">
				<div>
					<p class="foot-title">Categorías</p>
					<ul class="foot-links">
						{
							sectores.map(([slug, label]) => (
								<li>
									<a href={`/${slug}`}>{label}</a>
								</li>
							))
						}
					</ul>
				</div>
				<div>
					<p class="foot-title">Sitio</p>
					<ul class="foot-links">
						<li><a href="/sobre">Sobre {SITE_TITLE}</a></li>
						<li><a href="/privacidad">Política de privacidad</a></li>
					</ul>
				</div>
			</div>
		</div>
		<p class="bottom">
			&copy; {today.getFullYear()} {SITE_TITLE}. No estamos afiliados a Hotmart, Envato, Udemy ni
			Gumroad.
		</p>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1.5em 2.5em;
		background: var(--navy-950);
		color: var(--mist);
	}
	.footer-inner {
		max-width: 1100px;
		margin: 0 auto;
	}
	.foot-top {
		display: flex;
		justify-content: space-between;
		gap: 2.5em;
		margin-bottom: 1.6em;
		flex-wrap: wrap;
	}
	.foot-brand-col {
		max-width: 34ch;
	}
	.foot-brand {
		font-family: var(--font-display, Georgia, serif);
		font-style: italic;
		font-weight: 600;
		font-size: 1.15em;
		margin: 0 0 0.5em;
		color: var(--sky);
	}
	.foot-brand .dot {
		color: var(--brass-bright);
		font-style: normal;
	}
	.disclosure {
		font-size: 0.82em;
		line-height: 1.55;
		margin: 0;
		color: var(--mist);
	}
	.foot-nav {
		display: flex;
		gap: 2.5em;
	}
	.foot-title {
		font-size: 0.78em;
		margin: 0 0 0.4em;
		color: var(--mist-dim);
	}
	.foot-links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.3em;
	}
	.foot-links a {
		text-decoration: none;
		color: var(--mist);
		font-size: 0.85em;
	}
	.foot-links a:hover {
		color: var(--brass-bright);
	}
	.bottom {
		font-size: 0.76em;
		margin: 0;
		padding-top: 1.2em;
		border-top: 1px solid var(--navy-700);
		color: var(--mist-dim);
	}
	@media (max-width: 640px) {
		.foot-top {
			flex-direction: column;
			gap: 1.4em;
		}
		.foot-nav {
			gap: 2em;
		}
	}
</style>
