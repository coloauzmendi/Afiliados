---
import type { SubcategoriaConDesde } from '../lib/catalogo';
import { formatFecha, formatPrecio, sectorLabel } from '../lib/productos';

interface Props {
	subcategoria: SubcategoriaConDesde;
}

const { subcategoria } = Astro.props;
---

<a class="nota-card" href={`/${subcategoria.sector}/${subcategoria.slug}`} style={`--tint: var(--${subcategoria.sector})`}>
	<span class="nota-sector">{sectorLabel(subcategoria.sector)}</span>
	<h3>{subcategoria.title}</h3>
	<p class="nota-resumen">{subcategoria.resumen}</p>
	<div class="nota-footer">
		{
			subcategoria.desde !== null && (
				<span class="nota-precio">
					desde {formatPrecio(subcategoria.desde.valor, subcategoria.desde.moneda)}
				</span>
			)
		}
		<span class="nota-fecha">{formatFecha(subcategoria.fecha)}</span>
	</div>
</a>

<style>
	.nota-card {
		display: flex;
		flex-direction: column;
		padding: 1.3em;
		border: 1px solid var(--paper-dim);
		border-top: 3px solid var(--tint);
		border-radius: var(--radius-md);
		background: var(--paper);
		text-decoration: none;
		color: var(--navy-900);
		box-shadow: var(--box-shadow);
		transition:
			border-color 0.15s ease,
			transform 0.15s ease;
	}
	.nota-card:hover {
		border-color: var(--brass);
		border-top-color: var(--tint);
		transform: translateY(-3px);
	}
	.nota-sector {
		font-family: var(--font-mono, monospace);
		font-size: 0.68em;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: color-mix(in srgb, var(--tint) 65%, #101a2c);
		font-weight: 500;
		margin-bottom: 0.6em;
	}
	.nota-card h3 {
		font-size: 1.15em;
		margin: 0 0 0.4em;
		color: var(--navy-900);
	}
	.nota-resumen {
		font-size: 0.88em;
		color: #746c58;
		flex: 1;
	}
	.nota-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 1em;
		padding-top: 0.8em;
		border-top: 1px dashed #cfc7ac;
		font-size: 0.82em;
	}
	.nota-precio {
		font-family: var(--font-mono, monospace);
		font-weight: 500;
		color: var(--navy-900);
	}
	.nota-fecha {
		color: #857c63;
	}
</style>
