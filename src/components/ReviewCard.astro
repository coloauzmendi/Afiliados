---
import type { CollectionEntry } from 'astro:content';
import { formatFecha, formatPrecio, parsePrecio, sectorLabel } from '../lib/productos';

interface Props {
	review: CollectionEntry<'reviews'>;
}

const { review } = Astro.props;
const desde = review.data.productos?.length
	? Math.min(...review.data.productos.map((p) => parsePrecio(p.precioAprox)))
	: undefined;
---

<a class="nota-card" href={`/${review.data.sector}/${review.id}`}>
	<span class="nota-sector">{sectorLabel(review.data.sector)}</span>
	<h3>{review.data.title}</h3>
	<p class="nota-resumen">{review.data.resumen}</p>
	<div class="nota-footer">
		{desde !== undefined && <span class="nota-precio">Desde {formatPrecio(desde)}</span>}
		<span class="nota-fecha">{formatFecha(review.data.fecha)}</span>
	</div>
</a>

<style>
	.nota-card {
		display: flex;
		flex-direction: column;
		padding: 1.3em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		background: #fff;
		text-decoration: none;
		color: inherit;
	}
	.nota-card:hover {
		border-color: var(--accent);
	}
	.nota-sector {
		font-size: 0.7em;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--accent);
		font-weight: 700;
		margin-bottom: 0.5em;
	}
	.nota-card h3 {
		font-size: 1.1em;
		margin: 0 0 0.4em;
		color: rgb(var(--black));
	}
	.nota-resumen {
		font-size: 0.9em;
		color: rgb(var(--gray-dark));
		flex: 1;
	}
	.nota-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 1em;
		font-size: 0.8em;
	}
	.nota-precio {
		font-weight: 700;
		color: rgb(var(--black));
	}
	.nota-fecha {
		color: rgb(var(--gray));
	}
</style>
