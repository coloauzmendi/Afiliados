# Copiá este archivo a ".env" (sin el ".example") y completá con los datos
# reales de tu servicio MySQL en Aiven. El archivo ".env" nunca se sube a git.

DB_HOST=tu-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=tu-contraseña
DB_NAME=defaultdb

# Opcional: ID de medición de Google Analytics (Admin → Flujos de datos →
# tu flujo web, empieza con "G-"). Si se deja vacío o se borra la línea,
# el sitio no carga ningún script de analytics.
PUBLIC_GA_ID=

# Solo para publicar en Telegram (scripts/publicar-telegram.js), no lo usa
# el sitio. Token del bot (te lo da @BotFather) y el chat id de tu canal
# (si es público, "@tu_canal" tal cual).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
